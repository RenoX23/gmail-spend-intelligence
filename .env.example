# Google Gemini API Key for hybrid extraction fallback & natural language anomaly explanation
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client Secrets Path (for Live Gmail Mode)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Desktop App)
GMAIL_CLIENT_SECRETS_FILE=credentials.json

# Optional: Streamlit App Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
